{
  "name": "Olist Customer Analytics",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#FFFFFF",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#1baf7a",
  "neutral": "#b5b4ae",
  "bad": "#e34948",
  "maximum": "#1f5aa6",
  "center": "#9fc0ec",
  "minimum": "#eef4fc",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0b0b0b" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F5F5F3" } }, "transparency": 0 }] }
    }
  }
}
